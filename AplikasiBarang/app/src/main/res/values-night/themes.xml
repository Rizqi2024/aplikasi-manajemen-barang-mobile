<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Match Light theme so custom light cards & text remain 100% legible even when system dark mode is active -->
    <style name="Base.Theme.AplikasiBarang" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_accent</item>
        <item name="android:windowBackground">@color/bg_screen</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
